@startuml
caption <color:#2E7D32>added</color> or <color:#C62828><s>removed</s></color> — the impacted elements only (2 of 9 shown)

title Database Schema (ERD) - Diff
footer db/migration/*.sql -> DB -> dump to DB.sql -> converted to DB.puml
hide circle
hide empty members
skinparam linetype ortho
entity "vets" as vets {
  {field} id : int <<PK>>
  {field} first_name : text
  {field} last_name : text
}
entity "visits" as visits {
  {field} id : int <<PK>>
  {field} pet_id : int <<FK>>
  {field} visit_date : date
  {field} description : text
  {field} visit_time : time
  <color:#2E7D32>{field} vet_id : int <<FK>></color>
}

vets ||-[#2E7D32]-o{ visits : <color:#2E7D32>vet_id</color>

@enduml
