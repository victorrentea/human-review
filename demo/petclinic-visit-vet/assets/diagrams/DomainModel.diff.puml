@startuml
title Domain Model
caption <color:red>added</color> or <color:red><s>removed</s></color>

class Owner {
  id : Integer
  firstName : String
  lastName : String
  address : String
  city : String
  telephone : String
}
class Pet {
  id : Integer
  name : String
  birthDate : LocalDate
}
class PetType {
  id : Integer
  name : String
}
class Role {
  id : Integer
  name : String
}
class Specialty {
  id : Integer
  name : String
  description : String
}
class User {
  username : String
  password : String
  enabled : Boolean
}
class Vet {
  id : Integer
  firstName : String
  lastName : String
}
class Visit {
  id : Integer
  date : LocalDate
  time : LocalTime
  description : String
}

footer domain/*.java -> petclinic-backend/docs/generated/DomainModel.puml
Owner "1" -- "0..*" Pet : owner
Pet "1" -- "0..*" Visit : pet
PetType "1" -- "0..*" Pet : type
User "1" -- "0..*" Role : user
Vet "1" -- "0..*" Specialty : specialties
Vet "1" -[#red]- "0..*" Visit : <color:red>vet</color>

@enduml
