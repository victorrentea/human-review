<idea-plugin>
    <id>ro.victorrentea.human-review</id>
    <name>Human Review</name>
    <vendor url="https://github.com/victorrentea/human-review">Victor Rentea</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- The GitHub plugin's Pull Requests tool window (PullRequests.kt): two toggles in its
         right-click menus, registered only where it is enabled. Nothing else links against it. -->
    <depends optional="true" config-file="human-review-github.xml">org.jetbrains.plugins.github</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The loopback listener serve-review.py calls: one per IDE process (Bridge.kt). -->
        <postStartupActivity implementation="ro.victorrentea.humanreview.HumanReviewStartup"/>

        <!-- "human-review" in the status bar: is this checkout's review served? -->
        <statusBarWidgetFactory id="HumanReview.Status"
                                implementation="ro.victorrentea.humanreview.ReviewStatusWidgetFactory"
                                order="first"/>

        <applicationConfigurable parentId="tools" id="ro.victorrentea.human-review"
                                 displayName="Human Review"
                                 instance="ro.victorrentea.humanreview.HumanReviewConfigurable"/>

        <notificationGroup id="Human Review" displayType="BALLOON"/>

        <!-- jetbrains://idea/human-review/{open,diff,review-open}?… — a page read off disk (Links.kt). -->
        <jbProtocolCommand implementation="ro.victorrentea.humanreview.HumanReviewProtocolCommand"/>

        <!-- The review page beside the code, in JCEF (Page.kt): no stripe button until a page is shown. -->
        <toolWindow id="Human Review" anchor="right" icon="AllIcons.General.Web"
                    factoryClass="ro.victorrentea.humanreview.PageToolWindowFactory"/>
        <applicationService serviceInterface="ro.victorrentea.humanreview.PageView"
                            serviceImplementation="ro.victorrentea.humanreview.JcefPageView"/>
    </extensions>

    <!-- Updated without a restart (Lifecycle.kt): state put into editors is taken out before the
         unload, and a plugin loaded into a running IDE starts its bridge. -->
    <applicationListeners>
        <listener class="ro.victorrentea.humanreview.HumanReviewPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>
</idea-plugin>
